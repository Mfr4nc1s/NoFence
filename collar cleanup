# ===================================================================
# 8 (Fixed): Merge Report + GPS Interval Data into Main Dataset
# Author: Matthew Francis
# Description:
#   - Merges interval data (report + GPS) with main collar dataset
#   - Automatically detects correct timestamp column names
# ===================================================================

# ------------------------------
# Load packages
# ------------------------------
library(tidyverse)

# ------------------------------
# Set working directory
# ------------------------------
setwd("C:/Users/Supriya Monajigari/Documents")

# ------------------------------
# 1. Load main cleaned dataset
# ------------------------------
collar_df <- read_csv("collars_clean_phases.csv")

# Use the in-memory dataframes created earlier:
gps_interval_blank <- gps_intervals_all
report_interval_blank <- report_intervals_all

# ------------------------------
# 2. Standardize column names
# ------------------------------
names(collar_df) <- gsub(" ", ".", names(collar_df))
names(gps_interval_blank) <- gsub(" ", ".", names(gps_interval_blank))
names(report_interval_blank) <- gsub(" ", ".", names(report_interval_blank))

# Check which timestamp columns exist
print(names(collar_df))

# If your collar dataset has "Position.Time" instead of "Position.Time.MDT",
# create the correct column name for joining
if (!"Position.Time.MDT" %in% names(collar_df) && "Position.Time" %in% names(collar_df)) {
  collar_df <- collar_df %>%
    rename(Position.Time.MDT = Position.Time)
}

# ------------------------------
# 3. Merge GPS and report intervals into main dataset
# ------------------------------
collar_intervals <- collar_df %>%
  left_join(
    select(
      gps_interval_blank,
      Serial, Time.Mountain, Position.Time.MDT, GPS.Interval.Sec
    ),
    by = c("Serial", "Time.Mountain", "Position.Time.MDT")
  ) %>%
  left_join(
    select(
      report_interval_blank,
      Serial, Time.Mountain, Report.Interval.Sec
    ),
    by = c("Serial", "Time.Mountain")
  )

# ------------------------------
# 4. Save final merged dataset
# ------------------------------
write_csv(collar_intervals, "collars_with_all_intervals.csv")

# ------------------------------
# 5. Print summary
# ------------------------------
cat("✅ Intervals successfully merged into main dataset!\n")
cat("Rows:", nrow(collar_intervals), " | Columns:", ncol(collar_intervals), "\n")
cat("File saved as 'collars_with_all_intervals.csv' in Documents.\n")

# ===================================================================
# End of Script
# ===================================================================


