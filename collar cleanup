```{r}
# ===================================================================
# Final Collar Data Cleanup
# Author: Matthew Francis
# Description:
#   - Cleans collar dataset after all merges and interval calculations
#   - Removes technical columns only if they exist
#   - Creates master and working datasets for analysis
# ===================================================================

library(tidyverse)
library(lubridate)

# ------------------------------
# Set working directory
# ------------------------------
setwd("C:/Users/Supriya Monajigari/Documents")

# ------------------------------
# 1. Read the main dataset (with intervals)
# ------------------------------
collar_all <- read_csv("collars_with_all_intervals.csv")

# ------------------------------
# 2. Drop unnecessary technical columns (ignore if missing)
# ------------------------------
drop_cols <- c(
  "Time",
  "Position Time",
  "Humidity", "Pressure",
  "GSM RAT", "GSM Operator", "Min RSSI", "Max RSSI",
  "Horizontal Accuracy", "HDOP", "#Satellites",
  "Battery Voltage", "Solar Charge", "Temperature",
  "Pasture ID", "Pasture Version", "Collar Version", "Source_Sheet"
)

clean_collar_dat <- collar_all %>%
  select(-any_of(drop_cols))

# ------------------------------
# 3. Create working dataset for analysis
# ------------------------------
keep_cols <- c(
  "Serial", "Cow_id", "Latitude", "Longitude",
  "Time.Mountain", "Date", "Hour", "Phase", "Access_Status",
  "Activity", "Mode", "Fence Status", "Collar Status",
  "GPS.Interval.Sec", "Report.Interval.Sec"
)

working_collar_dat <- clean_collar_dat %>%
  select(any_of(keep_cols))

# ------------------------------
# 4. Write cleaned datasets to CSV
# ------------------------------
write_csv(clean_collar_dat, "collars_clean_master.csv")
write_csv(working_collar_dat, "collars_working_dataset.csv")

# ------------------------------
# 5. Summary
# ------------------------------
cat("✅ Cleaned datasets written to Documents folder.\n")
cat("Files created:\n")
cat(" - collars_clean_master.csv\n")
cat(" - collars_working_dataset.csv\n")
cat("Rows in working dataset:", nrow(working_collar_dat), "\n")
cat("Columns in working dataset:", ncol(working_collar_dat), "\n")


# ===================================================================

```

